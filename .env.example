# Docker image names
BACKEND_IMAGE=ghcr.io/xariif/engineeringwork-backend:latest
FRONTEND_IMAGE=ghcr.io/xariif/engineeringwork-frontend:latest
BACKEND_IMAGE_DEBUG=ghcr.io/xariif/engineeringwork-backend:debug
FRONTEND_IMAGE_DEBUG=ghcr.io/xariif/engineeringwork-frontend:debug

# Frontend build-time API URL
VITE_API_BASE_URL=https://api.example.com

# Backend
FrontendUrl=https://app.example.com
Jwt__Issuer=engineeringwork
Jwt__Audience=engineeringwork-users
Jwt__Key=CHANGE_ME_TO_LONG_RANDOM_SECRET
Jwt__ExpirationInDays=7
Jwt__RoleClaimType=role
Jwt__NameClaimType=name
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=engineeringwork;Username=user;Password=pass
EmailSettings__Server=smtp.example.com
EmailSettings__Port=587
EmailSettings__Username=user@example.com
EmailSettings__Password=CHANGE_ME
