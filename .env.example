# ─── Database ────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=change_me_strong_password
DB_NAME=engineeringwork

# ─── Backend ─────────────────────────────────────────────────────────────────
# URL of the deployed frontend (used for CORS whitelist)
FrontendUrl=http://localhost:80

# JWT settings
Jwt__Issuer=engineering-work
Jwt__Audience=engineering-work-users
# Must be at least 32 characters
Jwt__Key=change_me_very_long_and_secure_jwt_signing_key_32plus
Jwt__ExpirationInDays=7
Jwt__RoleClaimType=http://schemas.microsoft.com/ws/2008/06/identity/claims/role
Jwt__NameClaimType=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name

# Email (SMTP)
EmailSettings__Server=smtp.example.com
EmailSettings__Port=587
EmailSettings__Username=your_email@example.com
EmailSettings__Password=your_email_password

# ─── Frontend (baked in at Docker build time) ─────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000
VITE_API_MAILSENDER=your_mailersend_api_key

# ─── GitHub Container Registry (used in docker-compose image names) ───────────
GITHUB_REPOSITORY_OWNER=Xariif
