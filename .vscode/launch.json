{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run: .NET Core Backend",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "prep-backend",
			"program": "${workspaceFolder}/backend/bin/Debug/net8.0/backend.dll",
			"cwd": "${workspaceFolder}/backend",
			"env": {
				"ASPNETCORE_ENVIRONMENT": "Development"
			},
			"console": "integratedTerminal"
		},
		{
			"name": "Run: Frontend",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}/frontend",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev"],
			"preLaunchTask":  "prep-frontend",
			"console": "integratedTerminal",
			
		},
	],
	"compounds": [
		{
			"name": "Backend + Frontend",
			"configurations": ["Run: .NET Core Backend", "Run: Frontend"],
			"stopAll": true		}
	]
}
