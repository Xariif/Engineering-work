{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run: .NET Core Backend",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "prep-backend",
			"program": "${workspaceFolder}/backend/bin/Debug/net8.0/backend.dll",
			"cwd": "${workspaceFolder}/backend",
			"env": {
				"ASPNETCORE_ENVIRONMENT": "Development"
			},
			"console": "integratedTerminal"
		},
		{
			"name": "Run: Frontend",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}/frontend",
			"runtimeExecutable": "npm",
			"runtimeArgs": [
				"run",
				"dev"
			],
			"preLaunchTask": "prep-frontend",
			"console": "integratedTerminal"
		},
		{
			"name": "Containers: .NET Launch",
			"type": "docker",
			"request": "launch",
			"preLaunchTask": "docker-run: debug",
			"netCore": {
				"appProject": "${workspaceFolder}/backend/backend.csproj"
			}
		},
		{
			"name": "Containers: Node.js Launch",
			"type": "docker",
			"request": "launch",
			"preLaunchTask": "docker-run: debug",
			"platform": "node",
			"node": {
				"package": "${workspaceFolder}/frontend/package.json",
				"localRoot": "${workspaceFolder}/frontend"
			}
		}
	],
	"compounds": [
		{
			"name": "Backend + Frontend",
			"configurations": ["Run: .NET Core Backend", "Run: Frontend"],
			"stopAll": true		}
	]
}
